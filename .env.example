# Environment variables for JobMama (Vite).
# Copy this file to `.env` and fill in real values.
# Only VITE_-prefixed vars are exposed to the client build.

# Google Tag Manager container ID (format: GTM-XXXXXXX)
VITE_GTM_ID=

# Google Search Console verification token
# (the content value from the <meta name="google-site-verification"> tag)
VITE_GSC_VERIFICATION=

# Newsletter / lead-magnet form endpoint (e.g. a MailerLite form action URL).
# When blank, the lead-magnet email-capture section is hidden.
VITE_NEWSLETTER_FORM_ACTION=
